const { getPool } = require("../shared/db");
const sql = require("mssql");
const jwt = require("jsonwebtoken");

module.exports = async function (context, req) {
    const { vehicleId } = req.query;
    const authHeader = req.headers["authorization"];
    const token = authHeader && authHeader.split(" ")[1];

    context.res = {
        headers: {
            "Access-Control-Allow-Origin": "*",
            "Access-Control-Allow-Methods": "GET, OPTIONS",
            "Access-Control-Allow-Headers": "Content-Type, Authorization",
            "Content-Type": "application/json"
        }
    };

    if (req.method === "OPTIONS") {
        context.res.status = 204;
        context.res.body = "";
        return;
    }

    if (!token) {
        context.res.status = 401;
        context.res.body = { message: "Authorization token required" };
        return;
    }

    if (!vehicleId) {
        context.res.status = 400;
        context.res.body = { message: "vehicleId is required" };
        return;
    }

    let userId;

    try {
        const decoded = jwt.verify(token, process.env.JWT_SECRET);

        if (!decoded.userId) {
            context.res.status = 401;
            context.res.body = { message: "Invalid token payload" };
            return;
        }

        userId = decoded.userId;
    } catch {
        context.res.status = 401;
        context.res.body = { message: "Invalid or expired token" };
        return;
    }

    try {
        const pool = await getPool();

        // Verify vehicle ownership first.
        const vehicleResult = await pool.request()
            .input("VehicleId", sql.UniqueIdentifier, vehicleId)
            .input("UserId", sql.UniqueIdentifier, userId)
            .query(`
                SELECT Make, Model, Year, CurrentOdometer
                FROM Vehicles
                WHERE VehicleId = @VehicleId
                  AND UserId = @UserId;
            `);

        if (!vehicleResult.recordset.length) {
            context.res.status = 404;
            context.res.body = { message: "Vehicle not found or unauthorized" };
            return;
        }

        const vehicle = vehicleResult.recordset[0];

        /*
         * No database/schema changes are required.
         *
         * #FuelData is a request-local temp table. LAG() calculates the
         * previous odometer for every historical fuel entry in SQL.
         *
         * The API returns only:
         *   1. vehicle information
         *   2. latest five entries
         *   3. whole-history dashboard totals
         *   4. six monthly chart points
         *
         * No full FuelEntries dataset is sent to the browser.
         */
        const result = await pool.request()
            .input("VehicleId", sql.UniqueIdentifier, vehicleId)
            .query(`
                SELECT
                    EntryId,
                    VehicleId,
                    EntryDate,
                    Odometer,
                    Liters,
                    PricePerLiter,
                    TotalCost,
                    IsFullTank,
                    Notes,
                    LAG(Odometer) OVER (
                        ORDER BY EntryDate ASC, EntryId ASC
                    ) AS PreviousOdometer
                INTO #FuelData
                FROM FuelEntries
                WHERE VehicleId = @VehicleId;

                /* Result set 1: latest five entries only. */
                SELECT TOP (5)
                    EntryId,
                    VehicleId,
                    EntryDate,
                    Odometer,
                    CASE
                        WHEN PreviousOdometer IS NOT NULL
                             AND Odometer > PreviousOdometer
                        THEN Odometer - PreviousOdometer
                        ELSE 0
                    END AS DistanceKm,
                    Liters,
                    PricePerLiter,
                    TotalCost,
                    IsFullTank,
                    Notes
                FROM #FuelData
                ORDER BY EntryDate DESC, EntryId DESC;

                /* Result set 2: whole-history dashboard statistics. */
                SELECT
                    COUNT_BIG(*) AS EntryCount,
                    COALESCE(SUM(CAST(Liters AS decimal(18, 4))), 0) AS TotalLiters,
                    COALESCE(SUM(CAST(TotalCost AS decimal(18, 4))), 0) AS TotalCost,
                    COALESCE(MAX(Odometer) - MIN(Odometer), 0) AS TotalDistance,
                    CASE
                        WHEN COALESCE(MAX(Odometer) - MIN(Odometer), 0) > 0
                             AND COALESCE(SUM(CAST(Liters AS decimal(18, 4))), 0) > 0
                        THEN
                            (MAX(Odometer) - MIN(Odometer))
                            / SUM(CAST(Liters AS decimal(18, 4)))
                        ELSE NULL
                    END AS AvgEfficiency,
                    CASE
                        WHEN COALESCE(MAX(Odometer) - MIN(Odometer), 0) > 0
                        THEN
                            SUM(CAST(TotalCost AS decimal(18, 4)))
                            / (MAX(Odometer) - MIN(Odometer))
                        ELSE NULL
                    END AS AvgCostPerKm,
                    CASE
                        WHEN COALESCE(SUM(CAST(Liters AS decimal(18, 4))), 0) > 0
                        THEN
                            SUM(CAST(TotalCost AS decimal(18, 4)))
                            / SUM(CAST(Liters AS decimal(18, 4)))
                        ELSE NULL
                    END AS AvgCostPerLiter,
                    SUM(
                        CASE
                            WHEN IsFullTank = 0 THEN 1
                            ELSE 0
                        END
                    ) AS PartialEntryCount
                FROM #FuelData;

                /*
                 * Result set 3: six calendar months ending with the current
                 * month. Months with no qualifying fuel entry are returned
                 * with NULL efficiency so the chart keeps all six months.
                 *
                 * Monthly efficiency uses the distance segment represented
                 * by each fuel entry:
                 *
                 *     KM/L = monthly distance / monthly fuel
                 */
                ;WITH MonthSeries AS (
                    SELECT
                        DATEADD(
                            MONTH,
                            -5,
                            DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE()), 1)
                        ) AS MonthStart

                    UNION ALL

                    SELECT DATEADD(MONTH, 1, MonthStart)
                    FROM MonthSeries
                    WHERE MonthStart <
                        DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE()), 1)
                )
                SELECT
                    m.MonthStart AS Date,
                    CASE
                        WHEN SUM(
                            CASE
                                WHEN f.PreviousOdometer IS NOT NULL
                                     AND f.Odometer > f.PreviousOdometer
                                THEN f.Odometer - f.PreviousOdometer
                                ELSE 0
                            END
                        ) > 0
                        AND SUM(
                            CASE
                                WHEN f.PreviousOdometer IS NOT NULL
                                     AND f.Odometer > f.PreviousOdometer
                                THEN f.Liters
                                ELSE 0
                            END
                        ) > 0
                        THEN
                            SUM(
                                CASE
                                    WHEN f.PreviousOdometer IS NOT NULL
                                         AND f.Odometer > f.PreviousOdometer
                                    THEN f.Odometer - f.PreviousOdometer
                                    ELSE 0
                                END
                            )
                            /
                            SUM(
                                CASE
                                    WHEN f.PreviousOdometer IS NOT NULL
                                         AND f.Odometer > f.PreviousOdometer
                                    THEN f.Liters
                                    ELSE 0
                                END
                            )
                        ELSE NULL
                    END AS Efficiency,
                    COALESCE(
                        SUM(
                            CASE
                                WHEN f.PreviousOdometer IS NOT NULL
                                     AND f.Odometer > f.PreviousOdometer
                                THEN f.Odometer - f.PreviousOdometer
                                ELSE 0
                            END
                        ),
                        0
                    ) AS DistanceKm,
                    COALESCE(
                        SUM(
                            CASE
                                WHEN f.PreviousOdometer IS NOT NULL
                                     AND f.Odometer > f.PreviousOdometer
                                THEN f.Liters
                                ELSE 0
                            END
                        ),
                        0
                    ) AS Liters,
                    COALESCE(
                        SUM(
                            CASE
                                WHEN f.PreviousOdometer IS NOT NULL
                                     AND f.Odometer > f.PreviousOdometer
                                THEN f.TotalCost
                                ELSE 0
                            END
                        ),
                        0
                    ) AS Cost,
                    COUNT(f.EntryId) AS EntryCount
                FROM MonthSeries m
                LEFT JOIN #FuelData f
                    ON f.EntryDate >= m.MonthStart
                   AND f.EntryDate < DATEADD(MONTH, 1, m.MonthStart)
                GROUP BY m.MonthStart
                ORDER BY m.MonthStart
                OPTION (MAXRECURSION 6);

                DROP TABLE #FuelData;
            `);

        const recentEntries = result.recordsets[0] || [];
        const statsRow = result.recordsets[1]?.[0] || {};
        const chartData = result.recordsets[2] || [];

        const totalLiters = Number(statsRow.TotalLiters || 0);
        const totalCost = Number(statsRow.TotalCost || 0);
        const totalDistance = Number(statsRow.TotalDistance || 0);
        const avgEfficiency = statsRow.AvgEfficiency == null
            ? null
            : Number(statsRow.AvgEfficiency);
        const avgCostPerKm = statsRow.AvgCostPerKm == null
            ? null
            : Number(statsRow.AvgCostPerKm);
        const avgCostPerLiter = statsRow.AvgCostPerLiter == null
            ? null
            : Number(statsRow.AvgCostPerLiter);

        context.res.status = 200;
        context.res.body = {
            vehicle,
            recentEntries: recentEntries.map(entry => ({
                EntryId: entry.EntryId,
                VehicleId: entry.VehicleId,
                EntryDate: entry.EntryDate,
                Odometer: Number(entry.Odometer),
                DistanceKm: Number(entry.DistanceKm || 0),
                Liters: Number(entry.Liters || 0),
                PricePerLiter: entry.PricePerLiter == null
                    ? null
                    : Number(entry.PricePerLiter),
                TotalCost: Number(entry.TotalCost || 0),
                IsFullTank: Boolean(entry.IsFullTank),
                Notes: entry.Notes || ""
            })),
            stats: {
                totalLiters: Number(totalLiters.toFixed(2)),
                totalCost: Number(totalCost.toFixed(2)),
                totalDistance: Number(totalDistance.toFixed(2)),
                avgEfficiency: avgEfficiency == null
                    ? null
                    : Number(avgEfficiency.toFixed(2)),
                avgCostPerKm: avgCostPerKm == null
                    ? null
                    : Number(avgCostPerKm.toFixed(4)),
                avgCostPerLiter: avgCostPerLiter == null
                    ? null
                    : Number(avgCostPerLiter.toFixed(2)),
                calculationNote: Number(statsRow.PartialEntryCount || 0) > 0
                    ? "Some entries are partial tank (approximate)"
                    : "All entries are full tank"
            },
            chartData: chartData.map(point => ({
                date: point.Date,
                efficiency: point.Efficiency == null
                    ? null
                    : Number(Number(point.Efficiency).toFixed(2)),
                distance: Number(point.DistanceKm || 0),
                liters: Number(point.Liters || 0),
                cost: Number(point.Cost || 0),
                entryCount: Number(point.EntryCount || 0)
            }))
        };
    } catch (err) {
        context.res.status = 500;
        context.res.body = {
            message: "Failed to calculate fuel statistics",
            error: err.message
        };
    }
};
